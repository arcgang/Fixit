{
  "info": {
    "title": "prometheus-grafana Observability API",
    "version": "1.0.0",
    "description": "Internal API exposed by the Prometheus/Grafana observability stack for health probes, metric snapshot queries, and alert-rule management used by the FixIt platform."
  },
  "paths": {
    "/v1/observability/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "List all configured CloudWatch / Prometheus alert rules",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRulePage"
                }
              }
            },
            "description": "Paginated list of alert rules"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "enum": [
                "firing",
                "pending",
                "inactive"
              ],
              "type": "string"
            },
            "required": false
          }
        ],
        "operationId": "listAlertRules"
      },
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Create a new Prometheus / CloudWatch alert rule",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRule"
                }
              }
            },
            "description": "Alert rule created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Alert rule with this name already exists"
          }
        },
        "operationId": "createAlertRule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRuleRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/v1/observability/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Return liveness and readiness status of the observability stack",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Stack is healthy"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "One or more components degraded"
          }
        },
        "operationId": "getObservabilityHealth"
      }
    },
    "/v1/observability/dashboards": {
      "get": {
        "tags": [
          "Dashboards"
        ],
        "summary": "List all Grafana dashboards registered in this stack",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardPage"
                }
              }
            },
            "description": "Paginated list of dashboards"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "operationId": "listDashboards"
      }
    },
    "/v1/observability/scrape-targets": {
      "get": {
        "tags": [
          "ScrapeTargets"
        ],
        "summary": "List all Prometheus scrape targets and their current UP/DOWN state",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeTargetPage"
                }
              }
            },
            "description": "Paginated list of scrape targets"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          },
          {
            "in": "query",
            "name": "health",
            "schema": {
              "enum": [
                "up",
                "down",
                "unknown"
              ],
              "type": "string"
            },
            "required": false
          }
        ],
        "operationId": "listScrapeTargets"
      }
    },
    "/v1/observability/alerts/{alertId}": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Retrieve a single alert rule by ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRule"
                }
              }
            },
            "description": "Alert rule found"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "alertId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "operationId": "getAlertRule"
      },
      "put": {
        "tags": [
          "Alerts"
        ],
        "summary": "Replace an existing alert rule",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRule"
                }
              }
            },
            "description": "Alert rule updated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Validation error"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "alertId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "operationId": "updateAlertRule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertRuleRequest"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "tags": [
          "Alerts"
        ],
        "summary": "Delete an alert rule",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "alertId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "operationId": "deleteAlertRule"
      }
    },
    "/v1/observability/metrics/snapshot": {
      "get": {
        "tags": [
          "Metrics"
        ],
        "summary": "Return a current snapshot of key platform metrics (p95 latency, error rate, availability, SSE connections)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricSnapshotPage"
                }
              }
            },
            "description": "Paginated list of metric snapshots"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Opaque pagination cursor"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          },
          {
            "in": "query",
            "name": "metricName",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by metric name prefix (e.g. http_server_requests)"
          }
        ],
        "operationId": "getMetricsSnapshot"
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://observability.fixit.internal",
      "description": "Internal cluster observability endpoint"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AlertRule": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AlertRuleRequest"
          },
          {
            "type": "object",
            "required": [
              "id",
              "state",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "state": {
                "enum": [
                  "firing",
                  "pending",
                  "inactive"
                ],
                "type": "string"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "Dashboard": {
        "type": "object",
        "required": [
          "id",
          "uid",
          "title",
          "url",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "uid": {
            "type": "string",
            "description": "Grafana dashboard UID"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Grafana permalink"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CursorPage": {
        "type": "object",
        "required": [
          "next_cursor",
          "limit"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "maximum": 200,
            "minimum": 1
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque; null on the last page"
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "overall",
          "components",
          "checked_at"
        ],
        "properties": {
          "overall": {
            "enum": [
              "UP",
              "DOWN",
              "DEGRADED"
            ],
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            }
          }
        }
      },
      "ScrapeTarget": {
        "type": "object",
        "required": [
          "id",
          "job",
          "instance",
          "health",
          "last_scraped_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "job": {
            "type": "string",
            "description": "Prometheus job label, e.g. fixit-api-backend"
          },
          "health": {
            "enum": [
              "up",
              "down",
              "unknown"
            ],
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "instance": {
            "type": "string",
            "description": "host:port of the scrape target"
          },
          "last_scraped_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "AlertRulePage": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertRule"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "DashboardPage": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dashboard"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "MetricSnapshot": {
        "type": "object",
        "required": [
          "metric_name",
          "labels",
          "value",
          "sampled_at"
        ],
        "properties": {
          "value": {
            "type": "number",
            "format": "double"
          },
          "labels": {
            "type": "object",
            "description": "Prometheus label set",
            "additionalProperties": {
              "type": "string"
            }
          },
          "sampled_at": {
            "type": "string",
            "format": "date-time"
          },
          "metric_name": {
            "type": "string",
            "description": "Prometheus metric name, e.g. http_server_requests_seconds_max"
          }
        }
      },
      "ComponentHealth": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Component name (prometheus, grafana, cloudwatch-alarm-sync)"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "enum": [
              "UP",
              "DOWN",
              "DEGRADED"
            ],
            "type": "string"
          }
        }
      },
      "AlertRuleRequest": {
        "type": "object",
        "required": [
          "name",
          "expr",
          "for",
          "severity",
          "annotations"
        ],
        "properties": {
          "for": {
            "type": "string",
            "description": "Duration string, e.g. 5m"
          },
          "expr": {
            "type": "string",
            "description": "PromQL expression or CloudWatch metric math expression"
          },
          "name": {
            "type": "string",
            "description": "Unique human-readable rule name"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "severity": {
            "enum": [
              "critical",
              "warning",
              "info"
            ],
            "type": "string"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "cloudwatch_alarm_arn": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional ARN of a linked AWS CloudWatch Alarm"
          }
        }
      },
      "ScrapeTargetPage": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScrapeTarget"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "MetricSnapshotPage": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetricSnapshot"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
